{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderpilot.app/schema/addons/v1/optiscaler-compatibility.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "upstream", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "snapshot_revision", "snapshot_sha256"],
      "properties": {
        "source": { "const": "optiscaler-wiki-compatibility-list" },
        "snapshot_revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fallback_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fallback_text": { "type": "string", "minLength": 1 }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["warning", "compatibility", "game_setting"] },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["steam_appid", "epic_id", "gog_id", "xbox_store_id", "exe_name"]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "launcher": {
          "enum": ["steam", "epic", "gog", "ubisoft", "ea", "battle_net", "xbox", "manual"]
        },
        "executable": { "type": "string", "pattern": "^[^\\\\/\\u0000]+\\.exe$" }
      }
    },
    "proxy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "automatic" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "slot"],
          "properties": {
            "kind": { "const": "exact" },
            "slot": {
              "enum": [
                "nvngx.dll",
                "dxgi.dll",
                "winmm.dll",
                "d3d12.dll",
                "version.dll",
                "dbghelp.dll",
                "wininet.dll",
                "winhttp.dll"
              ]
            }
          }
        }
      ]
    },
    "iniOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "key", "value"],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s*$)[^\\r\\n\\u0000\\[\\]=]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s*$)[^\\r\\n\\u0000\\[\\]=]+$"
        },
        "value": { "type": "string", "pattern": "^[^\\r\\n\\u0000]*$" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy",
        "ini_overrides",
        "restricted_modules",
        "optipatcher",
        "prerequisite"
      ],
      "properties": {
        "when": { "$ref": "#/$defs/when" },
        "proxy": { "$ref": "#/$defs/proxy" },
        "ini_overrides": { "type": "array", "items": { "$ref": "#/$defs/iniOverride" } },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments", "requirement"],
          "properties": {
            "arguments": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^-[A-Za-z0-9][A-Za-z0-9._=-]*$"
              }
            },
            "requirement": { "enum": ["required", "recommended"] }
          }
        },
        "restricted_modules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "optipatcher": {
          "enum": ["unspecified", "supported", "recommended", "unsupported"]
        },
        "prerequisite": { "enum": ["none", "luma"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "identities", "declared_inputs", "guidance", "variants"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["working", "conditional", "unsupported"] },
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identity" }
        },
        "declared_inputs": {
          "type": "array",
          "items": { "enum": ["dlss2_plus", "fsr2_plus", "xess"] }
        },
        "guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
