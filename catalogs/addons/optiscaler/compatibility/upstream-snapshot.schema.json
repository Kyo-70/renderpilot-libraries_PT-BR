{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "snapshot_revision", "snapshot_sha256", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "const": "optiscaler-wiki-compatibility-list" },
    "snapshot_revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rows": { "type": "array", "minItems": 1 }
  }
}
