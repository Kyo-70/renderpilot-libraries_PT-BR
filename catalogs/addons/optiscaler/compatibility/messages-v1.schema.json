{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderpilot.app/schema/addons/v1/optiscaler-compatibility-messages.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "messages"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fallback_text", "guidance_kind", "context"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fallback_text": { "type": "string", "minLength": 1 },
          "guidance_kind": { "enum": ["warning", "compatibility", "game_setting"] },
          "context": { "enum": ["warning", "compatibility", "game_setting"] }
        }
      }
    }
  }
}
