{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderpilot.app/schema/catalogs/addons/optiscaler/compatibility/authoring.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "source", "snapshot_sha256", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "source": { "const": "optiscaler-wiki-compatibility-list" },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message_id"],
      "properties": {
        "kind": { "enum": ["warning", "compatibility", "game_setting"] },
        "message_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy",
        "ini_overrides",
        "restricted_modules",
        "optipatcher",
        "prerequisite"
      ],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "launcher": {
              "enum": [
                "steam",
                "epic",
                "gog",
                "ubisoft",
                "ea",
                "battle_net",
                "xbox",
                "manual"
              ]
            },
            "executable": { "type": "string", "pattern": "^[^\\\\/\\u0000]+\\.exe$" }
          }
        },
        "proxy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "automatic" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "slot"],
              "properties": {
                "kind": { "const": "exact" },
                "slot": {
                  "enum": [
                    "nvngx.dll",
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "version.dll",
                    "dbghelp.dll",
                    "wininet.dll",
                    "winhttp.dll"
                  ]
                }
              }
            }
          ]
        },
        "ini_overrides": { "type": "array" },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments", "requirement"],
          "properties": {
            "arguments": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^-[A-Za-z0-9][A-Za-z0-9._=-]*$"
              }
            },
            "requirement": { "enum": ["required", "recommended"] }
          }
        },
        "restricted_modules": { "type": "array", "items": { "type": "string" } },
        "optipatcher": {
          "enum": ["unspecified", "supported", "recommended", "unsupported"]
        },
        "prerequisite": { "enum": ["none", "luma"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_ref",
        "game_target_id",
        "status",
        "declared_inputs",
        "variants"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$" },
        "source_ref": { "type": "string", "minLength": 1 },
        "game_target_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
        },
        "status": { "enum": ["working", "conditional", "unsupported"] },
        "declared_inputs": {
          "type": "array",
          "items": { "enum": ["dlss2_plus", "fsr2_plus", "xess"] }
        },
        "guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
