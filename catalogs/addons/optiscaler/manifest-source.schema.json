{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderpilot.app/schema/catalogs/addons/optiscaler/source.json",
  "title": "OptiScaler manifest authoring source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "current_release",
    "release_source",
    "member_catalog",
    "releases",
    "modules",
    "config_migrations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "$ref": "#/$defs/revision" },
    "current_release": { "$ref": "#/$defs/stableReleaseId" },
    "release_source": { "$ref": "#/$defs/releaseSource" },
    "member_catalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/sha256" },
      "additionalProperties": { "$ref": "#/$defs/memberDefinition" }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "config_migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/configMigration" }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "stableReleaseId": {
      "type": "string",
      "pattern": "^v(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveSize": { "type": "integer", "minimum": 1 },
    "archiveSize": { "type": "integer", "minimum": 1, "maximum": 134217728 },
    "moduleArtifactSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!.*:)(?!.*(?:^|[\\\\/])\\.\\.?(?:[\\\\/]|$))[^\\u0000]+$"
    },
    "artifactTarget": {
      "allOf": [{ "$ref": "#/$defs/safePath" }, { "not": { "const": "$proxy" } }]
    },
    "targetPath": {
      "anyOf": [{ "const": "$proxy" }, { "$ref": "#/$defs/safePath" }]
    },
    "releaseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository"],
      "properties": {
        "provider": { "const": "github_release" },
        "repository": { "const": "optiscaler/OptiScaler" }
      }
    },
    "githubPathSegment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        { "not": { "enum": [".", ".."] } },
        { "pattern": "^[^/\\\\?#\\u0000-\\u001F\\u007F]+$" }
      ]
    },
    "githubAssetName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "allOf": [
        { "not": { "enum": [".", ".."] } },
        { "pattern": "^[^/\\\\?#\\u0000-\\u001F\\u007F]+$" }
      ]
    },
    "immutableModuleTag": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+)*$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "githubAssetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "tag", "asset"],
      "properties": {
        "provider": { "const": "github_release" },
        "repository": { "const": "optiscaler/OptiPatcher" },
        "tag": { "$ref": "#/$defs/immutableModuleTag" },
        "asset": { "$ref": "#/$defs/githubAssetName" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "archive_sha256",
        "archive_size",
        "config_schema",
        "members"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableReleaseId" },
        "asset": {
          "allOf": [{ "$ref": "#/$defs/githubAssetName" }, { "pattern": "\\.7z$" }]
        },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "archive_size": { "$ref": "#/$defs/archiveSize" },
        "config_schema": { "type": "integer", "minimum": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "memberDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_path", "target", "size", "module"],
      "properties": {
        "archive_path": { "$ref": "#/$defs/safePath" },
        "target": { "$ref": "#/$defs/targetPath" },
        "size": { "$ref": "#/$defs/positiveSize" },
        "module": { "$ref": "#/$defs/moduleId" },
        "pe_x64": { "type": "boolean" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "optional", "bundled_by_default", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "optional": { "type": "boolean" },
        "bundled_by_default": { "type": "boolean" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleId" }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleId" }
        },
        "artifact": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sha256", "size", "target", "pe_x64"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "source": { "$ref": "#/$defs/githubAssetSource" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "$ref": "#/$defs/moduleArtifactSize" },
        "target": { "$ref": "#/$defs/artifactTarget" },
        "pe_x64": { "const": true }
      }
    },
    "configMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema",
        "to_schema",
        "from_section",
        "from_key",
        "to_section",
        "to_key"
      ],
      "properties": {
        "from_schema": { "type": "integer", "minimum": 1 },
        "to_schema": { "type": "integer", "minimum": 1 },
        "from_section": { "$ref": "#/$defs/safeIniAtom" },
        "from_key": { "$ref": "#/$defs/safeIniAtom" },
        "to_section": { "$ref": "#/$defs/safeIniAtom" },
        "to_key": { "$ref": "#/$defs/safeIniAtom" },
        "value_map": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/safeIniValue" },
          "additionalProperties": { "$ref": "#/$defs/safeIniValue" }
        }
      }
    },
    "safeIniAtom": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*$)[^\\r\\n\\u0000\\[\\]=]+$"
    },
    "safeIniValue": { "type": "string", "pattern": "^[^\\r\\n\\u0000]*$" },
    "proxyLeaf": {
      "type": "string",
      "minLength": 5,
      "pattern": "^(?![.]{1,2}$)(?!.*[:\\u0000/\\\\])[^:\\u0000/\\\\]+\\.dll$"
    }
  }
}
